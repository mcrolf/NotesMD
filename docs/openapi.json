{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "paths" : {
    "/api/notes" : {
      "get" : {
        "tags" : [ "note-controller" ],
        "operationId" : "list",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/NoteResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "note-controller" ],
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NoteCreateRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{id}/restore" : {
      "post" : {
        "tags" : [ "note-controller" ],
        "operationId" : "restore",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{id}/archive" : {
      "post" : {
        "tags" : [ "note-controller" ],
        "operationId" : "archive",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/auth/register" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AuthCredentialsRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthRegisterResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AuthCredentialsRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{id}" : {
      "get" : {
        "tags" : [ "note-controller" ],
        "operationId" : "get",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoteResponse"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "note-controller" ],
        "operationId" : "delete",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      },
      "patch" : {
        "tags" : [ "note-controller" ],
        "operationId" : "patch",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NoteUpdateRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoteResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/archived" : {
      "get" : {
        "tags" : [ "note-controller" ],
        "operationId" : "listArchived",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/NoteResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/account" : {
      "delete" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "deleteAccount",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DeleteAccountRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "NoteCreateRequest" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "maxLength" : 500,
            "minLength" : 0,
            "type" : "string"
          },
          "contentMarkdown" : {
            "maxLength" : 1000000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "NoteResponse" : {
        "required" : [ "archivedAt", "contentMarkdown", "createdAt", "id", "title", "updatedAt" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "title" : {
            "type" : "string"
          },
          "contentMarkdown" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "archivedAt" : {
            "type" : "string",
            "description" : "Set while the note is archived",
            "format" : "date-time",
            "nullable" : true
          }
        }
      },
      "AuthCredentialsRequest" : {
        "required" : [ "password", "username" ],
        "type" : "object",
        "properties" : {
          "username" : {
            "maxLength" : 255,
            "minLength" : 3,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 128,
            "minLength" : 8,
            "type" : "string"
          }
        }
      },
      "AuthRegisterResponse" : {
        "required" : [ "userId", "username" ],
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "username" : {
            "type" : "string"
          }
        }
      },
      "LoginResponse" : {
        "required" : [ "accessToken", "expiresIn", "tokenType", "username" ],
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "tokenType" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          },
          "username" : {
            "type" : "string"
          }
        }
      },
      "NoteUpdateRequest" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "maxLength" : 500,
            "minLength" : 0,
            "type" : "string"
          },
          "contentMarkdown" : {
            "maxLength" : 1000000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "DeleteAccountRequest" : {
        "required" : [ "confirmation" ],
        "type" : "object",
        "properties" : {
          "confirmation" : {
            "pattern" : "delete my account",
            "type" : "string"
          }
        }
      }
    }
  }
}
